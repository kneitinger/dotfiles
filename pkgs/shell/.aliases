#!/usr/bin/env bash

if [ "$TERM" = 'alacritty' ]; then
    alias se='TERM=xterm-256color sudoedit'
else
    alias se='sudoedit'
fi

alias vim='nvim'

# Directory traversal
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias tmp='cd /tmp'

# Colorize ls
if [ "$(uname)" = 'Linux' ]; then
    alias ls='ls --color=auto'
else
    alias ls='ls -G'
fi

alias la='ls -a'
alias lal='ls -lha'
alias ll='ls -lh'
alias ks='ls'

# Always ask before overwriting a file with mv or cp
alias mv='mv -i'
alias cp='cp -i'

# Allow sudo-ing aliases...no idea why this works
alias sudo='sudo '

# ZFS Aliases
alias zsnap='zfs list -t snap'
alias zsnaps='zfs list -t snap'
alias zprops='zfs get all'

# cats out all files in child directories. get it cat child heh heh
kittens() {
    tree
    find . -type f -exec echo -e "\\n***************{}***************" \; -exec cat {} \;
}

# Create directory and cd into it
mkcd() {
    mkdir "$1"
    cd "$1" || exit
}

# git status -> vim
# Finds untracked, added, and modified files in git repo and opens them in vim
gsv() {
    if git status &>/dev/null; then
        mapfile -t changed_files < <(git status --short | grep -E '^(\?\?|A | M) ' | cut -c '4-')
        vim "${changed_files[@]}"
    else
        echo "Working directory is not a git repository, exiting."
    fi
}

# Fuzzy find opener
# Passes result of fzf to command specified as arg
ff() {
    CMD=$1
    # vim -> nvim alias not recognized inhis function, so account for it
    if nvim -v >/dev/null 2>&1 && [ "$1" == "vim" ]; then
        CMD="nvim"
    fi

    # If command is 'cd', remove the filename and go to the parent dir,
    # else execute command as is
    if [ "$1" == "cd" ]; then
        "$CMD" "$(dirname "$(fzf)")"
    else
        "$CMD" "$(fzf)"
    fi
}

if [ "$(uname)" != "Darwin" ]; then
    alias open="xdg-open"
fi

cargo-example-run() {
    local workspace_root package_root query_cmd preview_cmd selection cmd target_dir

    # Use argument as target directory, or stay in current directory
    target_dir="${1:-.}"

    # Push to target directory if provided
    if [ "$target_dir" != "." ]; then
        pushd "$target_dir" >/dev/null || {
            echo "Failed to cd to $target_dir"
            return 1
        }
    fi

    # Setup trap to popd on exit/return
    trap 'popd >/dev/null 2>&1' EXIT

    # Exit if not in a rust project
    workspace_root=$(cargo locate-project --workspace --message-format plain | xargs dirname)
    if [ -z "$workspace_root" ]; then
        echo "Not in a cargo workspace, exiting."
        return 1
    fi

    # FZF setup
    query_cmd="cargo metadata --no-deps --format-version 1 | jq -r '.packages[].targets[] | select(.kind[] == \"example\") | .src_path'"
    preview_cmd="head -n100 {} | grep ^//! | cut -b4-"
    selection=$(eval "$query_cmd" | fzf --preview-window wrap-word --preview "$preview_cmd")

    # Exit if no selection made
    if [ -z "$selection" ]; then
        echo "No example selected, exiting."
        return 1
    fi

    # Determing the package root of the selected example. Done to support workspaces where the example may not be in the root package
    package_root=$(pushd "$(dirname "$selection")" >/dev/null && cargo locate-project --message-format plain | xargs dirname && popd >/dev/null || exit 1)

    # Enable additional features for certain examples
    additional_features() {
        features=()

        # Repo specific features
        case $(basename $workspace_root) in
        *) ;;
        esac

        # Package specific features
        case $(basename "$package_root") in
        "bevy") features+=("wayland") ;;
        *) ;;
        esac

        # Example specific features
        case $(basename "$selection" .rs) in
        #"change_detection") features+=("track_location") ;;
        *) ;;
        esac

        if [ ${#features[@]} -gt 0 ]; then
            echo "$(
                IFS=,
                echo "${features[*]}"
            )"
        else
            echo ""
        fi
    }

    cmd="cargo run --package=$(basename "$package_root") --features=$(additional_features) --example $(basename "$selection" .rs)"

    echo "Running: ${cmd}"
    eval "$cmd"
}
